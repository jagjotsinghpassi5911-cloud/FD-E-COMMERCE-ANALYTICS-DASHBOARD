# First run: SQLite offline demo. After MongoDB is configured, change to mongodb.
DATA_BACKEND=sqlite
SQLITE_PATH=data/fd_demo.db
# For MongoDB Community or Atlas (never publish credentials):
# DATA_BACKEND=mongodb
# MONGODB_URI=mongodb://localhost:27017/
# MONGODB_DB=fd_ecommerce_analytics
# REQUIRED TO UNLOCK IMPORT/REPLACE/RAW-DATA EXPORT (choose your own password):
ADMIN_PASSWORD=
